{
  "expo": {
    "name": "Tilt Maze",
    "slug": "tilt-maze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abes.tiltmaze",
      "infoPlist": {
        "NSMotionUsageDescription": "Tilt Maze reads motion sensors so your phone can steer the game."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0c12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abes.tiltmaze",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tiltmaze",
    "backgroundColor": "#0b0c12",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Tilt Maze uses the camera to scan the pairing QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}